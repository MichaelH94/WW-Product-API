# Shopify CLI supplies the client credentials during `shopify app dev`.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Generate a unique random value of at least 32 characters for local use.
INTERNAL_API_KEY=replace-with-a-long-random-development-key

PORT=3000
