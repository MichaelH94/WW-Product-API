{
  "name": "test-run",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "shopify": "shopify",
    "build": "shopify app build",
    "build:api": "node --experimental-strip-types --check server/server.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "test": "node --test test/shopify/*.test.ts test/integration/*.test.ts test/worker/*.test.ts",
    "dev:api": "node --experimental-strip-types --watch server/server.ts",
    "dev:worker": "wrangler dev",
    "dev": "shopify app dev",
    "info": "shopify app info",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "deploy:worker": "wrangler deploy"
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "author": "Michael",
  "private": true,
  "devDependencies": {
    "wrangler": "^4.127.0"
  }
}
